# Valores de desarrollo: `npm run dev` los carga y backend/.env (si existe) los sobrescribe.
# Sin NODE_ENV la API arranca en modo producción: exige JWT_SECRET y CORS_ORIGINS y no carga
# los datos de ejemplo.
NODE_ENV=development
PORT=3000
# info | debug | warn | error | silent
LOG_LEVEL=info
# Orígenes permitidos por CORS, separados por coma. "*" permite todos (solo desarrollo).
CORS_ORIGINS=*
# Secreto para firmar los JWT (mínimo 32 caracteres). Obligatorio en producción.
# JWT_SECRET=
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=30
# Intentos de login/registro por IP cada 15 minutos
AUTH_INTENTOS_MAXIMOS=10
# Inicio de sesión con Google: IDs de cliente OAuth (web, iOS), separados por coma. Sin esto, /api/auth/google
# responde 503 y la app no muestra el botón.
# GOOGLE_CLIENT_IDS=123-abc.apps.googleusercontent.com,123-def.apps.googleusercontent.com
