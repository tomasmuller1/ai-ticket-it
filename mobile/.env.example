# Opcional: copiar a .env.local para forzar la URL del backend.
# Si no se define, la app usa la IP de la máquina donde corre `npx expo start`.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000/api

# Opcional: inicio de sesión con Google. En Google Cloud Console, crear un ID de cliente OAuth de tipo
# "Aplicación web" con origen y URI de redirección http://localhost:8081, y ponerlo acá y en
# GOOGLE_CLIENT_IDS de backend/.env.
# En Expo Go no se muestra: Google no puede volver a la app. Funciona en web y en una development build
# (en iOS, con un ID de cliente de iOS).
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=123-abc.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=123-def.apps.googleusercontent.com
