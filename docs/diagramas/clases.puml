@startuml clases
' Diagrama de clases de AI Ticket It. Las clases y los atributos son los del diagrama de la cátedra;
' lo que se sumó (el estado del evento) va en verde. Las notificaciones están en notificaciones.puml.
' La disposición está pensada para que ninguna flecha se cruce: las direcciones (-up->, -left->, …)
' ubican cada clase en su fila. Si se agrega una asociación, revisar que el SVG siga sin cruces.
' Para regenerar el SVG: java -Djava.awt.headless=true -jar plantuml.jar -tsvg docs/diagramas/clases.puml
' (también sirven la extensión PlantUML de VS Code o el plugin de IntelliJ).

skinparam defaultFontName Arial
skinparam shadowing false
skinparam roundCorner 0
skinparam classBorderThickness 2
skinparam ArrowThickness 1.3
skinparam linetype ortho
skinparam nodesep 90
skinparam ranksep 70
hide empty members
hide stereotype

skinparam class<<nuevo>> {
  BackgroundColor #E6F4EA
  BorderColor #2E7D32
}
skinparam enum<<nuevo>> {
  BackgroundColor #E6F4EA
  BorderColor #2E7D32
}

class Compra {
  - comprador: Usuario
  - evento: Evento
  - tipoEntrada: TipoEntrada
  - cantidad: Int
  - total: Double
  - estado: EstadoCompra
  - mensajes: Mensaje[]
  + actualizarEstado(EstadoCompra): void
}

enum EstadoCompra {
  PENDIENTE
  CONFIRMADA
  UTILIZADA
  CANCELADA
  REEMBOLSADA
}

class CambioEstadoCompra {
  - compra: Compra
  - estado: EstadoCompra
  - quien: Usuario
  - fechaHora: DateTime
}

class Mensaje {
  - usuario: Usuario
  - mensaje: String
  - enviado: DateTime
}

class Usuario {
  - nombre: String
  - apellido: String
  - favoritos: Evento[]
}

class Evento {
  - nombre: String
  - descripcion: String
  - categoria: Categoria
  - fecha: DateTime
  - tiposEntrada: TipoEntrada[]
  - multimedia: String[]
  - organizador: Usuario
  - <color:#2E7D32>estado: EstadoEvento
  + tuPrecioEstaEntre(Int, Int): Boolean
  + <color:#2E7D32>posponer(DateTime): void
  + <color:#2E7D32>cancelar(): void
}

class TipoEntrada {
  - nombre: String
  - descripcion: String
  - precio: Double
  - cupo: Int
  + hayCupoPara(Int): Boolean
}

class Categoria {
  - nombre: String
  - descripcion: String
}

class Resenia {
  - comprador: Usuario
  - evento: Evento
  - detalle: String
  - puntuacion: Double
}

enum EstadoEvento <<nuevo>> {
  PROGRAMADO
  POSPUESTO
  CANCELADO
}

' Fila de arriba: la compra y su estado.
Compra -left-> EstadoCompra
' Segunda fila: el historial de estados y los mensajes, entre la compra y el usuario.
CambioEstadoCompra -up-> EstadoCompra
CambioEstadoCompra -up-> Compra
CambioEstadoCompra -down-> Usuario
Compra -down-> "*" Mensaje
Mensaje -down-> Usuario
' Tercera fila: usuario, evento y tipos de entrada, uno al lado del otro.
Compra -down-> Usuario
Compra -down-> Evento
Compra -down-> TipoEntrada
Usuario -right-> "*" Evento : favoritos
Evento -left-> Usuario : organizador
Evento -right-> "*" TipoEntrada
' Abajo: la reseña, la categoría y el estado del evento.
Resenia -up-> Usuario
Resenia -up-> Evento
Evento -down-> EstadoEvento
Evento -down-> Categoria

legend bottom right
  |<#E6F4EA>     | En verde, lo que se sumó al diagrama de la consigna |
endlegend
@enduml
