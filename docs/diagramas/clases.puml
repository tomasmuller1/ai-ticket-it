@startuml clases
' Diagrama de clases de AI Ticket It. La parte de la consigna es el diagrama de la cátedra, tal cual;
' lo que se sumó (notificaciones y estado del evento) va en verde y se explica en la leyenda.
' Para regenerar el SVG: java -Djava.awt.headless=true -jar plantuml.jar -tsvg docs/diagramas/clases.puml
' (también sirven la extensión PlantUML de VS Code o el plugin de IntelliJ).

skinparam shadowing false
skinparam roundCorner 0
skinparam classBorderThickness 2
skinparam ArrowThickness 1.3
skinparam nodesep 40
skinparam ranksep 55
hide empty members
hide stereotype

skinparam class<<nuevo>> {
  BackgroundColor #E6F4EA
  BorderColor #2E7D32
}
skinparam enum<<nuevo>> {
  BackgroundColor #E6F4EA
  BorderColor #2E7D32
}

class Usuario {
  - nombre: String
  - apellido: String
  - favoritos: Evento[]
}

class Evento {
  - nombre: String
  - descripcion: String
  - categoria: Categoria
  - fecha: DateTime
  - tiposEntrada: TipoEntrada[]
  - multimedia: String[]
  - organizador: Usuario
  - <color:#2E7D32>estado: EstadoEvento
  + tuPrecioEstaEntre(Int, Int): Boolean
  + <color:#2E7D32>posponer(DateTime): void
  + <color:#2E7D32>cancelar(): void
}

class Categoria {
  - nombre: String
  - descripcion: String
}

class TipoEntrada {
  - nombre: String
  - descripcion: String
  - precio: Double
  - cupo: Int
  + hayCupoPara(Int): Boolean
}

class Compra {
  - comprador: Usuario
  - evento: Evento
  - tipoEntrada: TipoEntrada
  - cantidad: Int
  - total: Double
  - estado: EstadoCompra
  - mensajes: Mensaje[]
  + actualizarEstado(EstadoCompra): void
}

enum EstadoCompra {
  PENDIENTE
  CONFIRMADA
  UTILIZADA
  CANCELADA
  REEMBOLSADA
}

class CambioEstadoCompra {
  - compra: Compra
  - estado: EstadoCompra
  - quien: Usuario
  - fechaHora: DateTime
}

class Mensaje {
  - usuario: Usuario
  - mensaje: String
  - enviado: DateTime
}

class Resenia {
  - comprador: Usuario
  - evento: Evento
  - detalle: String
  - puntuacion: Double
}

enum EstadoEvento <<nuevo>> {
  PROGRAMADO
  POSPUESTO
  CANCELADO
}

class Notificacion <<nuevo>> {
  - destinatario: Usuario
  - tipo: TipoNotificacion
  - titulo: String
  - cuerpo: String
  - evento: Evento
  - compra: Compra
  - tipoEntrada: TipoEntrada
  - fechaHora: DateTime
  - leida: Boolean
  - cantidad: Int
  + marcarLeida(): void
}

enum TipoNotificacion <<nuevo>> {
  PAGO_CONFIRMADO
  PAGO_RECHAZADO
  RESERVA_VENCIDA
  REEMBOLSO_REALIZADO
  ENTRADA_UTILIZADA
  MENSAJE_NUEVO
  ENTRADAS_AGOTADAS
  EVENTO_AGOTADO
  EVENTO_POSPUESTO
  EVENTO_CANCELADO
}

CambioEstadoCompra --> Usuario
CambioEstadoCompra -down-> Compra
CambioEstadoCompra --> EstadoCompra
Compra --> Usuario
Compra --> Evento
Compra --> TipoEntrada
Compra --> EstadoCompra
Compra --> "*" Mensaje
Resenia --> Usuario
Resenia -down-> Evento
Mensaje -left-> Usuario
Evento -down-> Categoria
Evento --> "*" TipoEntrada
Usuario --> "*" Evento : favoritos
Evento --> Usuario : organizador

Evento -left-> EstadoEvento
Notificacion -left-> Evento
Notificacion -up-> Usuario : destinatario
Notificacion -up-> "0..1" Compra
Notificacion -down-> "0..1" TipoEntrada
Notificacion -down-> TipoNotificacion

legend bottom right
  |<#E6F4EA>     | En verde, lo que se sumó al diagrama de la consigna |
endlegend
@enduml
